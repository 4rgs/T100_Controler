[Unit]
Description=T100 Motor Controller (Auto-Update) - L298N
Wants=network-online.target pigpiod.service
After=network-online.target pigpiod.service
Requires=pigpiod.service

[Service]
Type=simple
User=4rgs
Group=4rgs
WorkingDirectory=/opt/web-motor/T100_Controler
ExecStart=/opt/web-motor/T100_Controler/start_with_update.sh
Restart=on-failure
RestartSec=10
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/opt/web-motor/T100_Controler

# Configuración de logging
StandardOutput=journal
StandardError=journal

# Configuración de seguridad
NoNewPrivileges=true
PrivateTmp=true

# Timeout para permitir actualización
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
