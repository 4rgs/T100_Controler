[Unit]
Description=T100 Motor Controller (Modularizado) - L298N
Wants=network-online.target pigpiod.service
After=network-online.target pigpiod.service
Requires=pigpiod.service

[Service]
Type=simple
User=4rgs
Group=4rgs
WorkingDirectory=/opt/web-motor
ExecStart=/opt/web-motor/venv/bin/python3 motor_control.py
Restart=on-failure
RestartSec=5
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/opt/web-motor

# Configuración de logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=web-motor

# Configuración de red
Environment=FLASK_HOST=0.0.0.0
Environment=FLASK_PORT=8080

[Install]
WantedBy=multi-user.target
